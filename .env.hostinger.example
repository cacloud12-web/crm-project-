# Copy to .env on the Hostinger server (NOT on your Mac for daily dev).
# On Hostinger, MySQL is on the same machine — use localhost, not srv1999.hstgr.io.

APP_NAME="CA Cloud Desk CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.caclouddesk.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# Database — from hPanel → Databases → MySQL Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u636438798_crmproject
DB_USERNAME=u636438798_crmuser
DB_PASSWORD=Crmproject@123

# Use file drivers first — database session/cache require migrated tables.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Prefer database queue + cron drain on Hostinger (jobs table already exists).
# sync blocks HTTP for OCR/bulk/campaigns — only use as last resort.
CACHE_STORE=file
QUEUE_CONNECTION=database
# After deploy: php artisan config:cache && route:cache && view:cache && event:cache
# Cron: * * * * * cd /path/to/public_html && php artisan schedule:run

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
# Configure SMTP in hPanel or your mail provider

VITE_APP_NAME="${APP_NAME}"
